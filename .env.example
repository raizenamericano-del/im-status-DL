DATABASE_URL=postgresql://imhub:replace-password@localhost:5432/imhub?schema=public
# Exact browser origins, comma separated; NO trailing slash or wildcard.
APP_ORIGIN=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
WORKER_SECRET=
# Secure must be true on public HTTPS. false ONLY for local HTTP development.
COOKIE_SECURE=true
ENABLE_WHATSAPP=true
WORKER_URL=http://127.0.0.1:3210
WORKER_PORT=3210
# Only the worker needs this directory. Mount Railway volume at /data, use /data/media.
MEDIA_ROOT=./runtime/media
PORT=3000
SERVICE_ROLE=web
# Only needed for Docker Compose. Use a hex password to avoid URL-encoding issues.
POSTGRES_PASSWORD=
# Optional, must be a disposable DB whose name ends in _test. Tests erase its data.
TEST_DATABASE_URL=
# Leave false in production. Only needed for an embedded Arena preview.
ALLOW_ARENA_EMBED=false
